# Copy to .env and fill in. Never commit .env.

# ---- Required -------------------------------------------------------------------------------
# Free LLM pool (config/models.yaml). Groq alone works; each extra key adds fallback capacity.
GROQ_API_KEY=
# Speech-to-text + text-to-speech
DEEPGRAM_API_KEY=

# ---- Optional LLM fallbacks (missing or expired keys are skipped) ----------------------------
GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   # only for keys from bigmodel.cn
CEREBRAS_API_KEY=
GOOGLE_API_KEY=

# ---- Bot ------------------------------------------------------------------------------------
COMPANY_NAME=Nimbus Mobile
BOT_NAME=Maya
TTS_VOICE=aura-2-thalia-en
TIMEZONE=America/New_York          # business hours, appointment slots, "today"

# ---- Database ------------------------------------------------------------------------------
# Running the app on your machine against `docker compose up -d db`:
DATABASE_URL=postgresql://ringmind:ringmind@localhost:5433/ringmind
# POSTGRES_PASSWORD=change-me      # used by docker compose; change for anything public
SEED_DEMO_DATA=true                # load the demo company into an empty database

# ---- Admin dashboard (/admin, user "admin"); unset = disabled --------------------------------
ADMIN_PASSWORD=

# ---- Operations -----------------------------------------------------------------------------
MAX_CONCURRENT_CALLS=10
MAX_CALL_MINUTES=20
BARGE_IN_MS=240

# ---- Twilio (real phone number) -------------------------------------------------------------
# Public URL Twilio can reach, e.g. from `ngrok http 8080`
PUBLIC_URL=https://your-subdomain.ngrok.app
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                 # enables webhook signature checks
TRANSFER_NUMBER=                   # with the two above: live transfer to a human

# ---- Free phone calls: Asterisk + softphone app (docker compose --profile phone up -d) -------
LAN_IP=                            # this Mac's Wi-Fi IP: ipconfig getifaddr en0
SIP_PASSWORD=                      # 8+ characters; softphone accounts 1001 / 1002
